# ─────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES
#
# For AWS deployments, set these via one of:
#   - ECS task definition (environment / secrets fields)
#   - AWS Systems Manager Parameter Store
#   - AWS Secrets Manager (recommended for secrets)
#   - AWS Amplify console (Settings → Environment Variables)
#
# NEVER commit real values to version control.
# ─────────────────────────────────────────────────────────────────

# ── Public (baked into client bundle at build time) ───────────────
# URL of your external backend API.
# Prefer the stable custom-domain URL so you never need to rebuild
# if the Elastic Beanstalk environment URL changes.
# Option A (recommended) — backend behind custom domain / reverse proxy:
NEXT_PUBLIC_API_BASE_URL=https://api.techbigsolutions.in
# Option B — direct Elastic Beanstalk URL (use until DNS is wired up):
# NEXT_PUBLIC_API_BASE_URL=https://techbigsols-backend-env.eba-icghip8n.ap-south-1.elasticbeanstalk.com

# Canonical URL of this Next.js app
NEXT_PUBLIC_SITE_URL=https://techbigsolutions.in

# ── Server-only secrets ───────────────────────────────────────────
# HMAC secret for admin JWT verification
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-strong-random-secret

# Alternative admin JWT secret (optional — takes precedence over JWT_SECRET for admin)
# ADMIN_JWT_SECRET=replace-with-strong-random-secret

# HMAC secret for portal user JWT (takes precedence over JWT_SECRET)
# Generate with: openssl rand -hex 32
USER_JWT_SECRET=replace-with-strong-random-secret

# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=production

# ── Dev bypass — MUST be empty / unset in production ─────────────
ADMIN_DEV_TOKEN=
NEXT_PUBLIC_ADMIN_DEV_TOKEN=
NEXT_PUBLIC_DEV_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=
