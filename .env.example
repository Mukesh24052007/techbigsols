# =================================================================
# TechBig Solutions - Environment Variables Configuration
# =================================================================

# ── Public URLs ──────────────────────────────────────────────────
# Backend API URL (Express backend running on port 5000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Authentication Secrets ───────────────────────────────────────
# HMAC secret for Admin JWT authentication & verification
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-strong-random-secret

# HMAC secret for Portal Employee/User JWT (required by /api/auth/user/login and /api/auth/user/me)
# Generate with: openssl rand -hex 32
USER_JWT_SECRET=replace-with-strong-random-secret

# ── Local SQLite Database ─────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Local Development Admin Credentials (Dev bypass) ──────────────
ADMIN_DEV_TOKEN=dev-secret-change-me
NEXT_PUBLIC_ADMIN_DEV_TOKEN=dev-secret-change-me
NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=your-dev-admin-password
